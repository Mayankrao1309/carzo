SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (use sqlite for dev)
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Razorpay
# Start with these TEST keys during development (from Razorpay Dashboard > Test Mode > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# When ready to go live: complete KYC on the Razorpay dashboard, switch to Live Mode,
# and replace the three values above with your rzp_live_ keys and live webhook secret.